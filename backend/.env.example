# ─────────────────────────────────────────────────────────────────────────────
# Plexi Upload Backend — Environment Variables
# Copy this file to .env and fill in the values before starting the server.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── GitHub OAuth App ──────────────────────────────────────────────────────────
# Create an OAuth App at https://github.com/settings/developers
# Set the Authorization callback URL to:
#   http://localhost:3001/api/auth/callback   (development)
#   https://your-backend-domain.com/api/auth/callback   (production)
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret

# ── GitHub Personal Access Token ─────────────────────────────────────────────
# Fine-grained PAT (recommended) or classic PAT with:
#   • Contents: Read & Write  (to create releases / upload assets)
#   • Issues:   Read & Write  (to create issues)
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_personal_access_token_here

# ── Repository ────────────────────────────────────────────────────────────────
GITHUB_REPO=KunalGupta25/plexi-materials

# ── URLs ──────────────────────────────────────────────────────────────────────
# The public URL of your frontend (used for CORS and OAuth redirect).
FRONTEND_URL=https://plexi-material.mexus.tech

# ── Auth ──────────────────────────────────────────────────────────────────────
# Secret used to sign the JWT auth cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
